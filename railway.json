{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "dotnet publish BuddyAssist.API/BuddyAssist.API.csproj -c Release -o out"
  },
  "deploy": {
    "startCommand": "dotnet out/BuddyAssist.API.dll",
    "restartPolicyType": "ON_FAILURE"
  }
}